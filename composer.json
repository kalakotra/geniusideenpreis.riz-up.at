{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-plugin": "^2.1",
        "silverstripe/vendor-plugin": "^3",
        "silverstripe/recipe-cms": "^6",
        "silverstripe/htmleditor-tinymce": "^1",
        "silverstripe/login-forms": "^6",
        "axllent/silverstripe-scss": "^2.1.2",
        "axllent/silverstripe-scaled-uploads": "^2.3.10",
        "axllent/silverstripe-meta-editor": "^1.2.4",
        "axllent/silverstripe-trailing-slash": "^2.2.8",
        "symbiote/silverstripe-gridfieldextensions": "^5",
        "bummzack/sortablefile": "^3",
        "jonom/focuspoint": "^6",
        "silverstripe/multiform": "^4",
        "unclecheese/display-logic": "^4",
        "phpoffice/phpspreadsheet": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "extra": {
        "resources-dir": "_resources",
        "expose": [
            "themes/geniusideen/css",
            "themes/geniusideen/images",
            "themes/geniusideen/javascript",
            "themes/geniusideen/webfonts"
        ],
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "install-frameworkmissing.html",
            "install.php",
            "web.config"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Amir Mehmedovic",
            "email": "kalakotra@gmail.com",
            "homepage": "https://kalakotra.com",
            "role": "Developer"
        }
    ]
}
